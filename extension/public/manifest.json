{
  "manifest_version": 3,
  "name": "Fine Print",
  "version": "0.0.1",
  "description": "A buyer's agent that rides along on property listings, built on Microburbs data.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api-ht.microburbs.com.au/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://www.realestate.com.au/*",
    "https://www.domain.com.au/*"
  ],
  "action": { "default_title": "Fine Print — your shortlist" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.realestate.com.au/*", "https://www.domain.com.au/*"],
      "js": ["content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
